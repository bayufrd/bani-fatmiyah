// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
}

datasource db {
  provider = "sqlite"
}

// Main model untuk anggota keluarga
model FamilyMember {
  id            String   @id @default(cuid())
  name          String
  arabicName    String?
  birth         String?
  death         String?
  gender        String?  // 'male' or 'female'
  generation    Int
  status        String?  // 'alive' or 'deceased'
  address       String?
  description   String?
  childNumber   Int?
  spouseName    String?
  
  // Relations
  parentIds     String?  // JSON array string untuk multiple parents
  spouseIds     String?  // JSON array string untuk multiple spouses
  childIds      String?  // JSON array string untuk children
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

